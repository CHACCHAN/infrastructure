# CI(QA-01)用のYAML lint設定。既存コードベースが通る現実的なルールから始める。
---
extends: default

ignore: |
  .legacy/
  collections/ansible_collections/

rules:
  # 日本語コメント込みで読みやすさを優先しているため行長は緩める
  line-length:
    max: 160
  # Ansibleの慣習(yes/no等)とGitHub Actionsの`on:`キーを許容
  truthy:
    allowed-values: ["true", "false", "yes", "no"]
    check-keys: false
  # `- { port: ..., proto: tcp }` の読みやすいフロー記法を許容
  braces:
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  # ---で始まるファイルとドキュメント区切りの混在を許容
  document-start: disable
