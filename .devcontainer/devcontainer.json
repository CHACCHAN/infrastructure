{
    "name": "Ansible Dev",
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "image": "mcr.microsoft.com/devcontainers/base:trixie",
    "features": {
        "ghcr.io/chacchan/devcontainer-features/my-assets:latest": {},
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.12"
        },
        "ghcr.io/devcontainers-extra/features/apt-packages:1": {
            "packages": "openssh-client,rsync,sshpass,jq,less"
        },
        "ghcr.io/devcontainers-extra/features/ansible:2": {
            "injections": "proxmoxer requests kubernetes ansible-lint ansible-builder"
        },
        "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
            "helm": "latest",
            "kubectl": "latest",
            "minikube": "none"
        },
        "ghcr.io/devcontainers-extra/features/kubectx-kubens:1": {},
        "ghcr.io/dhoeric/features/k9s:1": {},
        "ghcr.io/schlich/devcontainer-features/helmfile:1": {}
    },
    "postCreateCommand": "ansible-galaxy collection install -r ee/requirements.yml",
    "workspaceFolder": "/${localWorkspaceFolderBasename}",
    "workspaceMount": "source=${localWorkspaceFolder},target=/${localWorkspaceFolderBasename},type=bind,consistency=cached",
    "mounts": [
        "source=${localEnv:HOME}/.kube,target=/home/vscode/.kube,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.ansible_vault_pass,target=/home/vscode/.ansible_vault_pass,type=bind,consistency=cached"
    ],
    "containerEnv": {
        "DISABLE_AUTOUPDATER": "1",
        "ANSIBLE_VAULT_PASSWORD_FILE": "/home/vscode/.ansible_vault_pass",
        "ANSIBLE_HOST_KEY_CHECKING": "False",
        "ANSIBLE_STDOUT_CALLBACK": "default",
        "ANSIBLE_RESULT_FORMAT": "yaml"
    },
    "remoteEnv": {
        "PATH": "/usr/local/py-utils/venvs/ansible-core/bin:${containerEnv:PATH}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "redhat.ansible",
                "redhat.vscode-yaml",
                "ms-python.python",
                "ms-python.pylint",
                "eamodio.gitlens",
                "mhutchie.git-graph",
                "editorconfig.editorconfig",
                "streetsidesoftware.code-spell-checker",
                "gruntfuss.vscode-nginx-conf-hint",
                "timonwong.shellcheck",
                "foxundermoon.shell-format",
                "mikestead.dotenv",
                "pkief.material-icon-theme",
                "ms-kubernetes-tools.vscode-kubernetes-tools",
                "samuelcolvin.jinjahtml"
            ],
            "settings": {
                "editor.tabSize": 2,
                "ansible.python.interpreterPath": "/usr/local/py-utils/venvs/ansible-core/bin/python",
                "ansible.validation.lint.enabled": true,
                "ansible.validation.lint.path": "/usr/local/py-utils/venvs/ansible-core/bin/ansible-lint",
                "yaml.schemas": {
                    "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/ansible.json#/$defs/tasks": [
                        "roles/**/tasks/**/*.yml"
                    ],
                    "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/ansible.json#/$defs/playbook": [
                        "playbooks/**/*.yml"
                    ]
                },
                "[yaml]": {
                    "editor.defaultFormatter": "redhat.vscode-yaml",
                    "editor.tabSize": 2
                },
                "python.defaultInterpreterPath": "/usr/local/py-utils/venvs/ansible-core/bin/python",
                "python.terminal.activateEnvironment": false,
                "terminal.integrated.defaultProfile.linux": "bash",
                "workbench.iconTheme": "material-icon-theme",
                "explorer.compactFolders": false,
                "files.associations": {
                    "**/playbooks/**/*.yml": "ansible",
                    "**/roles/**/tasks/**/*.yml": "ansible",
                    "**/roles/**/handlers/**/*.yml": "ansible"
                }
            }
        }
    }
}
