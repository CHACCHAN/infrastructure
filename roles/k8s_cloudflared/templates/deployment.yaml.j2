# Cloudflare Tunnel コネクタ
#
# 前提: cloudflare namespace に Secret tunnel-token が存在すること
#   kubectl -n cloudflare create secret generic tunnel-token \
#     --from-literal=token='<Cloudflare ダッシュボードで発行したトークン>'
#
# トンネルの経路 (どのホスト名をどのオリジンへ送るか) は Cloudflare 側で
# 管理されており、このリポジトリには含まれない。現在の設定:
#   auth.{{ k8s_domain }} -> http://traefik.kube-system.svc.cluster.local:80
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloudflared
  namespace: cloudflare
  labels:
    app.kubernetes.io/name: cloudflared
spec:
  replicas: 2
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  selector:
    matchLabels:
      app: cloudflared
  template:
    metadata:
      labels:
        app: cloudflared
        app.kubernetes.io/name: cloudflared
    spec:
      # 2 レプリカが同じノードに寄らないようにする (ノード障害でトンネル全断を避ける)
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: kubernetes.io/hostname
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app: cloudflared
      securityContext:
        seccompProfile:
          type: RuntimeDefault
        # runAsNonRoot / runAsUser は付けていない。
        # cloudflared は distroless イメージで USER を名前 (nonroot) で宣言しており、
        # runAsNonRoot だけ付けると kubelet が UID を検証できず
        # CreateContainerConfigError になることがある。
        # 有効にする場合は runAsUser を数値で併記し、ロールアウトが通るか確認すること:
        #   runAsNonRoot: true
        #   runAsUser: 65532
        # (maxUnavailable: 0 なので失敗しても既存の 2 レプリカは残る)
      containers:
        - name: cloudflared
          # latest は使わない。更新するときはここを明示的に上げる。
          image: cloudflare/cloudflared:2026.7.3
          # 明示しないと k8s が既定値を埋める (タグが latest なら Always、
          # それ以外は IfNotPresent)。タグを固定しているので IfNotPresent でよい。
          # 書いておかないと、マニフェストを読んだだけでは実際の値が分からない。
          imagePullPolicy: IfNotPresent
          args:
            - tunnel
            - --no-autoupdate
            - --loglevel
            - info
            - --metrics
            - 0.0.0.0:2000
            - run
          env:
            - name: TUNNEL_TOKEN
              valueFrom:
                secretKeyRef:
                  name: tunnel-token
                  key: token
          ports:
            - name: metrics
              containerPort: 2000
              protocol: TCP
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          resources:
            requests:
              cpu: 10m
              memory: 64Mi
            limits:
              cpu: 500m
              memory: 256Mi
          readinessProbe:
            httpGet:
              path: /ready
              port: metrics
            initialDelaySeconds: 10
            periodSeconds: 10
          # コネクタが edge との接続を失ったまま固まった場合に再起動させる
          livenessProbe:
            httpGet:
              path: /ready
              port: metrics
            initialDelaySeconds: 30
            periodSeconds: 30
            failureThreshold: 5
---
# ノードのドレイン中でもトンネルを 1 本は維持する
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: cloudflared
  namespace: cloudflare
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app: cloudflared
