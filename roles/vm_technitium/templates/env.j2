# Ansible(roles/vm_technitium)が生成。手動編集は次回実行で上書きされます。
# ただしDNS_SERVER_ADMIN_PASSWORDは再実行時に既存値が引き継がれます。
#
# ここの値が反映されるのは config/dns.config が作られる初回起動時だけです
# (Technitiumの仕様。構築済みのサーバーの設定はWebコンソールから変更してください)。

# Webコンソールの管理者(admin)のパスワード
DNS_SERVER_ADMIN_PASSWORD={{ technitium_admin_password_resolved }}

# このDNSサーバー自身を指す名前(SOAレコード等に使われる)
DNS_SERVER_DOMAIN={{ technitium_server_domain }}

# 再帰問い合わせ(このサーバーが代わりに名前を引きに行く)を許す範囲
DNS_SERVER_RECURSION={{ technitium_recursion }}
{% if technitium_recursion_network_acl | length > 0 %}
DNS_SERVER_RECURSION_NETWORK_ACL={{ technitium_recursion_network_acl | join(',') }}
{% endif %}
{% if technitium_forwarders | length > 0 %}

# 上位DNSへの転送(未指定なら自分でルートサーバーから辿る)
DNS_SERVER_FORWARDERS={{ technitium_forwarders | join(',') }}
DNS_SERVER_FORWARDER_PROTOCOL={{ technitium_forwarder_protocol }}
{% endif %}

# 広告・トラッカー等のブロック
DNS_SERVER_ENABLE_BLOCKING={{ technitium_enable_blocking | bool | string | lower }}
{% if technitium_block_list_urls | length > 0 %}
DNS_SERVER_BLOCK_LIST_URLS={{ technitium_block_list_urls | join(',') }}
{% endif %}
{% if technitium_enable_https_console | bool %}

# WebコンソールのHTTPS(自己署名証明書)
DNS_SERVER_WEB_SERVICE_ENABLE_HTTPS=true
DNS_SERVER_WEB_SERVICE_USE_SELF_SIGNED_CERT=true
{% endif %}
{% if technitium_use_host_network | bool %}

# ホストネットワークではポート公開の仕組みを使わないため、
# Webコンソールの待ち受けポートそのものを指定する
DNS_SERVER_WEB_SERVICE_HTTP_PORT={{ technitium_http_port }}
DNS_SERVER_WEB_SERVICE_HTTPS_PORT={{ technitium_https_port }}
{% endif %}

# ログ(バインドマウントした logs/ に出力される)
DNS_SERVER_LOG_FOLDER_PATH=/var/log/technitium/dns
DNS_SERVER_LOG_USING_LOCAL_TIME={{ technitium_log_using_local_time | bool | string | lower }}
DNS_SERVER_LOG_MAX_LOG_FILE_DAYS={{ technitium_log_max_days }}
{% if technitium_extra_env | length > 0 %}

# technitium_extra_env で追加指定された項目
{% for key, value in (technitium_extra_env | dictsort) %}
{{ key }}={{ value }}
{% endfor %}
{% endif %}
