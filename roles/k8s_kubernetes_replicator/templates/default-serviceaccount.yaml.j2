# 各Namespaceの`default` ServiceAccountへimagePullSecretsを配る複製元。
# ServiceAccountの複製ではimagePullSecrets(とlabels)だけが複製先へ写る。
# 複製先の`default`は既存なので、コントローラはcreateではなくupdateで注入する。
apiVersion: v1
kind: ServiceAccount
metadata:
  name: default
  namespace: {{ k8s_kubernetes_replicator_source_namespace }}
  annotations:
    replicator.v1.mittwald.de/replicate-to: {{ k8s_kubernetes_replicator_target_namespaces | to_json }}
imagePullSecrets:
  - name: {{ k8s_kubernetes_replicator_secret_name }}
