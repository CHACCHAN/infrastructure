# Vault変数が定義されたSecretだけをラベル無しで生成する。
apiVersion: v1
kind: Secret
metadata:
  name: {{ k8s_secret_manifest_name }}
  namespace: {{ k8s_secret_manifest_namespace }}
type: Opaque
stringData:
{% for key, value in k8s_secret_manifest_data.items() %}
  {{ key }}: {{ value | string | to_json }}
{% endfor %}
