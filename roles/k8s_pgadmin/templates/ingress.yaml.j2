# pgAdmin の公開経路。
#
# Deployment / Service / PVC は上流チャート由来 (values は roles/k8s_pgadmin の defaults)。
# ここには Ingress だけを置く。上流チャートの ingress は enabled: false にしてある。
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: pgadmin
  namespace: platform
  labels:
    app.kubernetes.io/name: pgadmin4
    app.kubernetes.io/component: route
    app.kubernetes.io/managed-by: kustomize
  annotations:
    # HTTPS 専用で公開する。平文 HTTP (:80) では 404 になる。
    traefik.ingress.kubernetes.io/router.entrypoints: "websecure"
    # Authentik の forwardAuth Middleware はここでは使わない。
    # pgAdmin 自身が OIDC で Authentik に認証を投げるため (config.yaml)、
    # 前段でも認証すると二重になる。
    # traefik.ingress.kubernetes.io/router.middlewares: "platform-authentik-forward-auth@kubernetescrd"
spec:
  ingressClassName: traefik
  tls:
    - hosts:
        - "pgadmin.{{ k8s_domain }}"
      # platform/certificates/ の Certificate が作るワイルドカード証明書
      secretName: {{ k8s_tls_secret }}
  rules:
    - host: "pgadmin.{{ k8s_domain }}"
      http:
        paths:
          - path: "/"
            pathType: Prefix
            backend:
              service:
                # defaults の fullnameOverride で固定している名前。
                name: pgadmin
                port:
                  # チャートの service.portName。既定は http (:80)。
                  name: http
