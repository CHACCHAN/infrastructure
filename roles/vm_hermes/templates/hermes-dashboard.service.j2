# Ansible(roles/vm_hermes)が生成。手動編集は次回実行で上書きされます。
#
# 上流にはdashboardをサービス化するコマンドが無く、公式ドキュメントも
# 「systemd等のプロセスマネージャで常駐させる」としているためこのunitを持つ。
# 待受(--host/--port)はTraefikの転送先と対応するためここで指定し、
# 認証・公開URLは環境ファイルとconfig.yaml側が持つ。
[Unit]
Description=Hermes Agent web dashboard
After=network-online.target{% if hermes_install_docker | bool %} docker.service{% endif %}

Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User={{ ansible_user }}
Group={{ ansible_user }}
WorkingDirectory={{ hermes_install_dir }}
Environment=HOME={{ ansible_env.HOME }}
Environment=HERMES_HOME={{ hermes_home }}
# Hermesが持ち込むNode(初回起動時のWeb UIビルドでnpmを使う)とuvをPATHへ入れる
Environment=PATH={{ hermes_home }}/node/bin:{{ hermes_home }}/bin:{{ ansible_env.HOME }}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 認証情報。ファイルが無くても起動を止めない(先頭の-)
EnvironmentFile=-{{ hermes_dashboard_env_file }}
ExecStart={{ hermes_bin }} dashboard --host {{ hermes_dashboard_host }} --port {{ hermes_dashboard_port }} --no-open
Restart=always
RestartSec=10
TimeoutStopSec=60
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
