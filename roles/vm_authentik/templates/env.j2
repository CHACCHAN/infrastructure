# Ansible(roles/authentik)が生成。手動編集は次回実行で上書きされます。
# ただしPG_PASSとAUTHENTIK_SECRET_KEYは再実行時に既存値が引き継がれます。

# PostgreSQL
PG_DB={{ authentik_pg_db }}
PG_USER={{ authentik_pg_user }}
PG_PASS={{ authentik_pg_password_resolved }}

# Authentik本体
AUTHENTIK_SECRET_KEY={{ authentik_secret_key_resolved }}
AUTHENTIK_ERROR_REPORTING__ENABLED={{ authentik_error_reporting | bool | string | lower }}

# 使用するイメージ
AUTHENTIK_IMAGE={{ authentik_image }}
AUTHENTIK_TAG={{ authentik_version }}

# WebUIの公開ポート
COMPOSE_PORT_HTTP={{ authentik_http_port }}
COMPOSE_PORT_HTTPS={{ authentik_https_port }}
{% if (authentik_bootstrap_password | default('', true)) | length > 0
   or (authentik_bootstrap_email | default('', true)) | length > 0
   or (authentik_bootstrap_token | default('', true)) | length > 0 %}

# 初期管理者(akadmin)。効くのはDBを初期化する初回起動時のみ
{% if (authentik_bootstrap_password | default('', true)) | length > 0 %}
AUTHENTIK_BOOTSTRAP_PASSWORD={{ authentik_bootstrap_password }}
{% endif %}
{% if (authentik_bootstrap_email | default('', true)) | length > 0 %}
AUTHENTIK_BOOTSTRAP_EMAIL={{ authentik_bootstrap_email }}
{% endif %}
{% if (authentik_bootstrap_token | default('', true)) | length > 0 %}
AUTHENTIK_BOOTSTRAP_TOKEN={{ authentik_bootstrap_token }}
{% endif %}
{% endif %}
{% if authentik_extra_env | length > 0 %}

# authentik_extra_env で追加指定された項目
{% for key, value in (authentik_extra_env | dictsort) %}
{{ key }}={{ value }}
{% endfor %}
{% endif %}
