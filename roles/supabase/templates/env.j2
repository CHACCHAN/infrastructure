# Ansible(roles/supabase)が生成。手動編集は次回実行で上書きされます。
# ただしパスワードや鍵は再実行時に既存値が引き継がれます。
#
# 項目の意味は公式の .env.example と
# https://supabase.com/docs/guides/self-hosting/docker を参照してください。

# 使うcompose定義(上書き用の定義を足すときはここに並ぶ)
COMPOSE_FILE={{ supabase_compose_files | join(':') }}

############
# 秘密情報 — ⚠ DBの中身と対になっているため、作り直すとデータを読めなくなります
############

POSTGRES_PASSWORD={{ supabase_secrets.POSTGRES_PASSWORD }}

# 従来のHS256方式のキー
JWT_SECRET={{ supabase_secrets.JWT_SECRET }}
ANON_KEY={{ supabase_secrets.ANON_KEY }}
SERVICE_ROLE_KEY={{ supabase_secrets.SERVICE_ROLE_KEY }}

# 非対称鍵(ES256)方式のキー。supabase_enable_asymmetric_keys で生成
SUPABASE_PUBLISHABLE_KEY={{ supabase_secrets.SUPABASE_PUBLISHABLE_KEY | default('', true) }}
SUPABASE_SECRET_KEY={{ supabase_secrets.SUPABASE_SECRET_KEY | default('', true) }}
JWT_KEYS={{ supabase_secrets.JWT_KEYS | default('', true) }}
JWT_JWKS={{ supabase_secrets.JWT_JWKS | default('', true) }}

# ダッシュボード(Studio)のBasic認証
DASHBOARD_USERNAME={{ supabase_dashboard_username }}
DASHBOARD_PASSWORD={{ supabase_secrets.DASHBOARD_PASSWORD }}

SECRET_KEY_BASE={{ supabase_secrets.SECRET_KEY_BASE }}
REALTIME_DB_ENC_KEY={{ supabase_secrets.REALTIME_DB_ENC_KEY }}
VAULT_ENC_KEY={{ supabase_secrets.VAULT_ENC_KEY }}
PG_META_CRYPTO_KEY={{ supabase_secrets.PG_META_CRYPTO_KEY }}
LOGFLARE_PUBLIC_ACCESS_TOKEN={{ supabase_secrets.LOGFLARE_PUBLIC_ACCESS_TOKEN }}
LOGFLARE_PRIVATE_ACCESS_TOKEN={{ supabase_secrets.LOGFLARE_PRIVATE_ACCESS_TOKEN }}
S3_PROTOCOL_ACCESS_KEY_ID={{ supabase_secrets.S3_PROTOCOL_ACCESS_KEY_ID }}
S3_PROTOCOL_ACCESS_KEY_SECRET={{ supabase_secrets.S3_PROTOCOL_ACCESS_KEY_SECRET }}

############
# URL
############

# ブラウザ・クライアントから見たURL
SUPABASE_PUBLIC_URL={{ supabase_public_url_resolved }}
API_EXTERNAL_URL={{ supabase_api_external_url_resolved }}

############
# データベース
############

POSTGRES_HOST={{ supabase_postgres_host }}
POSTGRES_DB={{ supabase_postgres_db }}
POSTGRES_PORT={{ supabase_postgres_port }}

############
# Supavisor(コネクションプーラー)
############

POOLER_PROXY_PORT_TRANSACTION={{ supabase_pooler_proxy_port_transaction }}
POOLER_DEFAULT_POOL_SIZE={{ supabase_pooler_default_pool_size }}
POOLER_MAX_CLIENT_CONN={{ supabase_pooler_max_client_conn }}
POOLER_TENANT_ID={{ supabase_secrets.POOLER_TENANT_ID }}
POOLER_DB_POOL_SIZE={{ supabase_pooler_db_pool_size }}

############
# Studio(ダッシュボード)
############

STUDIO_DEFAULT_ORGANIZATION={{ supabase_studio_default_organization }}
STUDIO_DEFAULT_PROJECT={{ supabase_studio_default_project }}
OPENAI_API_KEY={{ supabase_openai_api_key }}

############
# Auth(GoTrue)
############

SITE_URL={{ supabase_site_url }}
ADDITIONAL_REDIRECT_URLS={{ supabase_additional_redirect_urls }}
JWT_EXPIRY={{ supabase_jwt_expiry }}
DISABLE_SIGNUP={{ supabase_disable_signup | bool | string | lower }}

MAILER_URLPATHS_CONFIRMATION="{{ supabase_mailer_urlpaths_confirmation }}"
MAILER_URLPATHS_INVITE="{{ supabase_mailer_urlpaths_invite }}"
MAILER_URLPATHS_RECOVERY="{{ supabase_mailer_urlpaths_recovery }}"
MAILER_URLPATHS_EMAIL_CHANGE="{{ supabase_mailer_urlpaths_email_change }}"

ENABLE_EMAIL_SIGNUP={{ supabase_enable_email_signup | bool | string | lower }}
ENABLE_EMAIL_AUTOCONFIRM={{ supabase_enable_email_autoconfirm | bool | string | lower }}
SMTP_ADMIN_EMAIL={{ supabase_smtp_admin_email }}
SMTP_HOST={{ supabase_smtp_host }}
SMTP_PORT={{ supabase_smtp_port }}
SMTP_USER={{ supabase_smtp_user }}
SMTP_PASS={{ supabase_smtp_pass }}
SMTP_SENDER_NAME={{ supabase_smtp_sender_name }}
ENABLE_ANONYMOUS_USERS={{ supabase_enable_anonymous_users | bool | string | lower }}

ENABLE_PHONE_SIGNUP={{ supabase_enable_phone_signup | bool | string | lower }}
ENABLE_PHONE_AUTOCONFIRM={{ supabase_enable_phone_autoconfirm | bool | string | lower }}

############
# API(PostgREST)
############

PGRST_DB_SCHEMAS={{ supabase_pgrst_db_schemas }}
PGRST_DB_MAX_ROWS={{ supabase_pgrst_db_max_rows }}
PGRST_DB_EXTRA_SEARCH_PATH={{ supabase_pgrst_db_extra_search_path }}

############
# Storage
############

GLOBAL_S3_BUCKET={{ supabase_global_s3_bucket }}
REGION={{ supabase_region }}
MINIO_ROOT_USER={{ supabase_minio_root_user }}
MINIO_ROOT_PASSWORD={{ supabase_secrets.MINIO_ROOT_PASSWORD }}
STORAGE_TENANT_ID={{ supabase_storage_tenant_id }}

############
# Edge Functions
############

FUNCTIONS_VERIFY_JWT={{ supabase_functions_verify_jwt | bool | string | lower }}

############
# ログ・分析(docker-compose.logs.yml を足したときに使われる)
############

DOCKER_SOCKET_LOCATION={{ supabase_docker_socket_location }}
GOOGLE_PROJECT_ID={{ supabase_google_project_id }}
GOOGLE_PROJECT_NUMBER={{ supabase_google_project_number }}

############
# APIゲートウェイ(Kong)
############

KONG_HTTP_PORT={{ supabase_kong_http_port }}
KONG_HTTPS_PORT={{ supabase_kong_https_port }}

# Kongが内部で使う(クライアントには渡さない)
ANON_KEY_ASYMMETRIC={{ supabase_secrets.ANON_KEY_ASYMMETRIC | default('', true) }}
SERVICE_ROLE_KEY_ASYMMETRIC={{ supabase_secrets.SERVICE_ROLE_KEY_ASYMMETRIC | default('', true) }}

############
# imgproxy
############

IMGPROXY_AUTO_WEBP={{ supabase_imgproxy_auto_webp | bool | string | lower }}
{% if (supabase_proxy_domain | default('', true)) | length > 0 %}

############
# TLSプロキシ(docker-compose.caddy.yml / nginx.yml を足したときに使われる)
############

PROXY_DOMAIN={{ supabase_proxy_domain }}
CERTBOT_EMAIL={{ supabase_certbot_email }}
{% endif %}
{% if supabase_extra_env | length > 0 %}

############
# supabase_extra_env で追加指定された項目
############

{% for key, value in (supabase_extra_env | dictsort) %}
{{ key }}={{ value }}
{% endfor %}
{% endif %}
