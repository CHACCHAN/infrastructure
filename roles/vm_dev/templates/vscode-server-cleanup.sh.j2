#!/usr/bin/env bash
# Ansible(roles/vm_dev)が生成。手動編集は次回実行で上書きされる。
set -euo pipefail

TARGET_DIR="/home/{{ ansible_user }}/.vscode-server"
RETENTION_DAYS="{{ dev_vscode_cleanup_retention_days }}"
BIN_DIR="${TARGET_DIR}/bin"

if [ ! -d "$BIN_DIR" ]; then
  echo "no ${BIN_DIR}, nothing to clean"
  exit 0
fi

find "$BIN_DIR" -mindepth 1 -maxdepth 1 -type d -mtime "+${RETENTION_DAYS}" -print -exec rm -rf {} \;
