# Ansible(roles/vm_dev)が生成。手動編集は次回実行で上書きされる。
# デスクトップ全体(システム既定)のMIME関連付け。
# ユーザー個別の ~/.config/mimeapps.list があればそちらが優先される。
[Default Applications]
text/html={{ dev_default_browser_desktop }}
application/xhtml+xml={{ dev_default_browser_desktop }}
x-scheme-handler/http={{ dev_default_browser_desktop }}
x-scheme-handler/https={{ dev_default_browser_desktop }}
x-scheme-handler/about={{ dev_default_browser_desktop }}
x-scheme-handler/unknown={{ dev_default_browser_desktop }}
