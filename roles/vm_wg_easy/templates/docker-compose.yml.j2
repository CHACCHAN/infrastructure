# Ansible(roles/wg_easy)が生成。手動編集は次回実行で上書きされます。
#
# 内容は公式の docker-compose.yml
# (https://github.com/wg-easy/wg-easy/blob/master/docker-compose.yml)と同じ構成。
# 差分は次の3点:
#   - 設定値は同じディレクトリの .env から渡す(公式はenvironmentに直接書いている)
#   - 設定とデータを名前付きボリュームではなくバインドマウントにしている
#     (設置ディレクトリごとバックアップできるようにするため)
#   - 公開ポートと待ち受けアドレスを変えられるようにしている
#
# NET_ADMIN / SYS_MODULE と sysctls はWireGuardの動作に必須です(公式のまま)。
---
services:
  wg-easy:
    container_name: {{ wg_easy_container_name }}
    image: {{ wg_easy_image }}:{{ wg_easy_version }}
    restart: unless-stopped
    env_file:
      - .env
    networks:
      {{ wg_easy_network_name }}:
        ipv4_address: {{ wg_easy_network_ipv4_address }}
{% if not (wg_easy_disable_ipv6 | bool) %}
        ipv6_address: {{ wg_easy_network_ipv6_address }}
{% endif %}
    ports:
      # WireGuard本体(UDP)
      - "{{ wg_easy_wg_port }}:{{ wg_easy_wg_port }}/udp"
{% if wg_easy_ui_bind in ['0.0.0.0', '::', ''] %}
      - "{{ wg_easy_ui_port }}:{{ wg_easy_ui_port }}/tcp"
{% else %}
      # Web UIの待ち受けアドレスを絞っている
      - "{{ wg_easy_ui_bind }}:{{ wg_easy_ui_port }}:{{ wg_easy_ui_port }}/tcp"
{% endif %}
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    sysctls:
      - net.ipv4.ip_forward=1
      - net.ipv4.conf.all.src_valid_mark=1
{% if not (wg_easy_disable_ipv6 | bool) %}
      - net.ipv6.conf.all.disable_ipv6=0
      - net.ipv6.conf.all.forwarding=1
      - net.ipv6.conf.default.forwarding=1
{% endif %}
    volumes:
      # 設定・鍵・クライアント情報(sqlite)
      - ./etc_wireguard:/etc/wireguard
      # ホストのカーネルモジュール(WireGuardの読み込みに使う)
      - /lib/modules:/lib/modules:ro

networks:
  {{ wg_easy_network_name }}:
    driver: bridge
{% if not (wg_easy_disable_ipv6 | bool) %}
    enable_ipv6: true
{% endif %}
    ipam:
      driver: default
      config:
        - subnet: {{ wg_easy_network_ipv4_subnet }}
{% if not (wg_easy_disable_ipv6 | bool) %}
        - subnet: {{ wg_easy_network_ipv6_subnet }}
{% endif %}
