# Ansible(roles/vm_wg_easy)が生成。手動編集は次回実行で上書きされます。
# ただしINIT_PASSWORDは再実行時に既存値が引き継がれます。
#
# 指定していない項目は書き出していません(イメージ側の既定値が使われます)。
# 項目の意味は https://wg-easy.github.io/wg-easy/latest/advanced/config/optional-config/

# Web UIの待ち受け(PORTはVM側の公開ポートと同じ番号にしている)
PORT={{ wg_easy_ui_port }}
HOST={{ wg_easy_host }}
# HTTPでのアクセスを許可するか(falseならHTTPS経由でしかログインできない)
INSECURE={{ wg_easy_insecure | bool | string | lower }}
DISABLE_IPV6={{ wg_easy_disable_ipv6 | bool | string | lower }}
DISABLE_VERSION_CHECK={{ wg_easy_disable_version_check | bool | string | lower }}
{% if wg_easy_experimental_awg | bool %}

# AmneziaWG(実験的機能)
EXPERIMENTAL_AWG=true
{% endif %}
{% if (wg_easy_debug | default('', true)) | length > 0 %}
DEBUG={{ wg_easy_debug }}
{% endif %}

# --- 初期セットアップ(反映されるのは初回起動時のみ) ---
INIT_ENABLED={{ wg_easy_init_enabled | bool | string | lower }}
{% if wg_easy_init_enabled | bool %}
INIT_USERNAME={{ wg_easy_init_username }}
INIT_PASSWORD={{ wg_easy_init_password_resolved }}
# クライアントが接続する先(VMのLAN内IPではなく、外から見たFQDN/IP)
INIT_HOST={{ wg_easy_init_host }}
INIT_PORT={{ wg_easy_init_port_resolved }}
{% if (wg_easy_init_dns | default('', true)) | length > 0 %}
INIT_DNS={{ wg_easy_init_dns }}
{% endif %}
{% if (wg_easy_init_ipv4_cidr | default('', true)) | length > 0 %}
# VPNのアドレス範囲(IPv4/IPv6はセットで指定する必要がある)
INIT_IPV4_CIDR={{ wg_easy_init_ipv4_cidr }}
INIT_IPV6_CIDR={{ wg_easy_init_ipv6_cidr }}
{% endif %}
{% if (wg_easy_init_allowed_ips | default('', true)) | length > 0 %}
INIT_ALLOWED_IPS={{ wg_easy_init_allowed_ips }}
{% endif %}
{% endif %}
{% if wg_easy_oauth_providers_resolved | length > 0 %}

# --- 外部認証 ---
OAUTH_PROVIDERS={{ wg_easy_oauth_providers_resolved | join(',') }}
OAUTH_AUTO_REGISTER={{ wg_easy_oauth_auto_register | bool | string | lower }}
{% if (wg_easy_oauth_allowed_domains | default('', true)) | length > 0 %}
# ログインを許可するメールアドレスのドメイン
OAUTH_ALLOWED_DOMAINS={{ wg_easy_oauth_allowed_domains }}
{% endif %}
{% if (wg_easy_oauth_auto_launch | default('', true)) | length > 0 %}
# ログイン画面を開いたときに自動で飛ばすプロバイダ
OAUTH_AUTO_LAUNCH={{ wg_easy_oauth_auto_launch }}
{% endif %}
{% if 'oidc' in wg_easy_oauth_providers_resolved %}

# 汎用OIDC(Authentik / Authelia など)
OAUTH_OIDC_SERVER={{ wg_easy_oauth_oidc_server }}
OAUTH_OIDC_CLIENT_ID={{ wg_easy_oauth_oidc_client_id }}
OAUTH_OIDC_CLIENT_SECRET={{ wg_easy_oauth_oidc_client_secret }}
{% if (wg_easy_oauth_oidc_name | default('', true)) | length > 0 %}
OAUTH_OIDC_NAME={{ wg_easy_oauth_oidc_name }}
{% endif %}
{% endif %}
{% if 'google' in wg_easy_oauth_providers_resolved %}

OAUTH_GOOGLE_CLIENT_ID={{ wg_easy_oauth_google_client_id }}
OAUTH_GOOGLE_CLIENT_SECRET={{ wg_easy_oauth_google_client_secret }}
{% endif %}
{% if 'github' in wg_easy_oauth_providers_resolved %}

OAUTH_GITHUB_CLIENT_ID={{ wg_easy_oauth_github_client_id }}
OAUTH_GITHUB_CLIENT_SECRET={{ wg_easy_oauth_github_client_secret }}
{% endif %}
{% endif %}
{% if wg_easy_disable_password_auth | bool %}

# パスワード認証を無効化する(外部認証でのみログインできる)
DISABLE_PASSWORD_AUTH=true
{% endif %}
{% if wg_easy_extra_env | length > 0 %}

# wg_easy_extra_env で追加指定された項目
{% for key, value in (wg_easy_extra_env | dictsort) %}
{{ key }}={{ value }}
{% endfor %}
{% endif %}
