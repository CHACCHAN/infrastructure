#!/usr/bin/env bash
# Ansible(roles/vm_dev)が生成。手動編集は次回実行で上書きされる。
set -euo pipefail

TARGET_DIR="/home/{{ ansible_user }}/.vscode-server"
RETENTION_DAYS="{{ dev_vscode_cleanup_retention_days }}"
# 版が展開される2か所(bin: Remote-SSH拡張、cli/servers: CLI経由)
CLEAN_DIRS=("${TARGET_DIR}/bin" "${TARGET_DIR}/cli/servers")

# 実行中のプロセスがパスを掴んでいる版は残す(接続中のセッションを切らないため)
RUNNING_PROCS="$(pgrep -a -f "${TARGET_DIR}" || true)"

for clean_dir in "${CLEAN_DIRS[@]}"; do
  if [ ! -d "$clean_dir" ]; then
    echo "no ${clean_dir}, nothing to clean"
    continue
  fi

  while IFS= read -r -d '' version_dir; do
    if printf '%s' "$RUNNING_PROCS" | grep -qF "$version_dir"; then
      echo "in use, keeping ${version_dir}"
      continue
    fi
    echo "removing ${version_dir}"
    rm -rf "$version_dir"
  done < <(find "$clean_dir" -mindepth 1 -maxdepth 1 -type d -mtime "+${RETENTION_DAYS}" -print0)
done
