# Ansible(roles/vm_hermes)が生成。手動編集は次回実行で上書きされる。
# web dashboardの認証プロバイダ設定。非loopback待受では1つ以上必須。
# 環境変数はHermesのconfig.yamlより優先される(上流仕様)。
{% if hermes_dashboard_enable_basic_auth | bool %}
# 同梱のusername/passwordプロバイダ。実値はvault/hermes.ymlが単一の真実
HERMES_DASHBOARD_BASIC_AUTH_USERNAME={{ hermes_dashboard_username }}
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD={{ hermes_dashboard_password | trim }}
# 署名鍵。固定しないと再起動ごとに全セッションが無効になる
HERMES_DASHBOARD_BASIC_AUTH_SECRET={{ hermes_dashboard_secret | trim }}
{% endif %}
{% if hermes_oidc_enabled %}
# SSO(self-hosted OIDCプラグイン)。issuerとclient_idが揃うとプロバイダが登録される
HERMES_DASHBOARD_OIDC_ISSUER={{ hermes_oidc_issuer | trim }}
HERMES_DASHBOARD_OIDC_CLIENT_ID={{ hermes_oidc_client_id | trim }}
HERMES_DASHBOARD_OIDC_SCOPES={{ hermes_oidc_scopes | trim }}
{% if (hermes_oidc_client_secret | default('', true)) | trim | length > 0 %}
# confidential clientのときだけ出力される(public clientはPKCEのみ)
HERMES_DASHBOARD_OIDC_CLIENT_SECRET={{ hermes_oidc_client_secret | trim }}
{% endif %}
{% endif %}
