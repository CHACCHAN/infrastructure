# ansible-lint設定(VSCode拡張とCIの両方が参照する)
---
# 実行に使うプロファイル相当の調整。既存コードベースの意図的な規約と衝突する
# ルールだけを除外し、それ以外は全て有効のまま維持する。
skip_list:
  # 役割内変数は「サービス名_*」(例: wg_easy_*)を採用している(ロール名の
  # vm_/k8s_プレフィックスはドメイン識別であり、変数には付けない設計)
  - var-naming[no-role-prefix]
  # タスク名は日本語(大文字開始の英語を強制しない)
  - name[casing]

# 実験的ルールは対象外(argsは誤検知が多い)
enable_list: []
warn_list:
  - experimental

exclude_paths:
  - vault/ # ansible-vault暗号化ファイル(環境変数なしでは復号できない)
  - collections/
  - .github/
