# ansible-lint 設定。VSCode の Ansible 拡張(redhat.ansible)もこのファイルを読む。
---
profile: production
offline: true

skip_list:
  # 変数名は層(pve_/vm_/k8s_)を落としたサービス名で揃える(role vm_k3s -> k3s_*)。
  - var-naming[no-role-prefix]
  # タスク名は日本語。文頭の製品名(cert-manager / k3s 等)は公式表記の小文字を使う。
  - name[casing]

exclude_paths:
  # 旧構成。移行完了まで参照用に残すだけで、検証の対象にしない。
  - legacy/
  - .ansible/
